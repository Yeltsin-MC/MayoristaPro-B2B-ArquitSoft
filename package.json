{
  "name": "mayoristapro",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:api": "npm run dev -w @mayoristapro/api",
    "dev:web": "npm run start -w @mayoristapro/web",
    "db:migrate": "node --env-file-if-exists=.env database/migrate.cjs",
    "db:seed": "node --env-file-if-exists=.env database/seed.cjs",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/*.integration.cjs",
    "test:unit": "node --test tests/*.test.cjs",
    "test:browser": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/catalog.browser.cjs tests/quotations.browser.cjs tests/experiencia-catalogo.browser.cjs tests/cantidad-mayorista.browser.cjs tests/continuidad-comprador.browser.cjs",
    "test:demo": "node --env-file-if-exists=.env --test tests/demo.browser.cjs",
    "demo:catalog:load": "node --env-file-if-exists=.env --env-file-if-exists=.env.demo-catalog150 database/demo/load.cjs",
    "demo:catalog:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.demo-catalog150 database/demo/serve.cjs",
    "identity:admin": "node --env-file-if-exists=.env database/create-admin.cjs",
    "demo:catalog:quote": "node --env-file-if-exists=.env --env-file-if-exists=.env.demo-catalog150 database/demo/quote.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
