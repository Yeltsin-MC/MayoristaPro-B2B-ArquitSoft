{
  "name": "mayoristapro",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:api": "npm run dev -w @mayoristapro/api",
    "dev:web": "npm run start -w @mayoristapro/web",
    "db:migrate": "node --env-file-if-exists=.env database/migrate.cjs",
    "db:seed": "node --env-file-if-exists=.env database/seed.cjs",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/*.integration.cjs",
    "test:unit": "node --test tests/*.test.cjs",
    "test:browser": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/catalog.browser.cjs tests/quotations.browser.cjs tests/experiencia-catalogo.browser.cjs tests/cantidad-mayorista.browser.cjs tests/continuidad-comprador.browser.cjs tests/cotizacion-simple.browser.cjs tests/lista-pedido.browser.cjs",
    "test:demo": "node --env-file-if-exists=.env --test tests/demo.browser.cjs",
    "test:carga": "node --env-file-if-exists=.env --env-file-if-exists=.env.demo-catalog150 tests/k6/run.cjs",
    "demo:catalog:load": "node --env-file-if-exists=.env --env-file-if-exists=.env.demo-catalog150 database/demo/load.cjs",
    "demo:catalog:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.demo-catalog150 database/demo/serve.cjs",
    "identity:admin": "node --env-file-if-exists=.env database/create-admin.cjs",
    "demo:catalog:quote": "node --env-file-if-exists=.env --env-file-if-exists=.env.demo-catalog150 database/demo/quote.cjs",
    "format": "prettier --write apps/api/src apps/web/src",
    "format:check": "prettier --check apps/api/src apps/web/src",
    "lint": "eslint apps/api/src apps/web/src",
    "puertos:ver": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/puertos.ps1 ver",
    "puertos:liberar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/puertos.ps1 liberar"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.0",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.72.2"
  }
}
