# Copiar a .env.demo y completar la contraseña antes de arrancar.
POSTGRES_USER=mayorista
POSTGRES_DB=mayorista
POSTGRES_PASSWORD=
# Puerto y dirección publicados por Nginx en la máquina local.
WEB_BIND=127.0.0.1
WEB_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
API_PORT=3000
AI_PORT=5000
AI_SERVICE_URL=
DEMO_SEED=true
WORKER_INTERVAL_SECONDS=120
DEMO_IMAGE_TAG=local
# Redis opcional. Activar el perfil cache después de integrar PR #5.
REDIS_URL=
CATALOG_CACHE_TTL_SECONDS=30
CATALOG_CACHE_TIMEOUT_MS=100
# Credenciales de sandbox opcionales, gestionadas por el operador.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
