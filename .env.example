DATABASE_URL=postgresql://mayorista:mayorista_local@localhost:5432/mayorista

# Caché pública opcional. PostgreSQL conserva la autoridad transaccional.
# REDIS_URL=redis://127.0.0.1:6379
CATALOG_CACHE_TTL_SECONDS=30
CATALOG_CACHE_TIMEOUT_MS=100

# Mercado Pago (opcional). Sin MP_ACCESS_TOKEN se usa el pago de prueba simulado.
# Usa el Access Token de PRUEBA (empieza con TEST-) de tu aplicación en Mercado Pago Developers.
# No lo subas al repositorio ni lo compartas.
# MP_ACCESS_TOKEN=
# Solo en el despliegue con HTTPS (para validar la firma del webhook):
# MP_WEBHOOK_SECRET=
