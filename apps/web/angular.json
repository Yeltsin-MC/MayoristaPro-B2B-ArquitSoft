{
  "version": 1,
  "cli": {"analytics": false},
  "projects": {
    "catalog": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": ["src/styles.css"],"assets": [{"glob":"**/*","input":"public","output":"/"}]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {"buildTarget": "catalog:build", "proxyConfig": "proxy.conf.cjs"}
        }
      }
    }
  }
}
