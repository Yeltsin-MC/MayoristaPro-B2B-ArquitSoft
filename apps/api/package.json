    "csv-parse": "6.1.0",
    "exceljs": "4.4.0",
    "pg": "^8",
    "reflect-metadata": "^0.2",
    "rxjs": "^7.8",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "@types/multer": "2.0.0",
    "@types/node": "^24",
