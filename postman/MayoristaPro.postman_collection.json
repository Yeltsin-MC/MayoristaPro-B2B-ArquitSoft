                  "const list = pm.response.json();",
                  "pm.test('El proveedor tiene productos', () => pm.expect(list).to.be.an('array').that.is.not.empty);",
                  "const p = list.find(x => x.stock >= 3 && x.minimum <= 3 && 3 % x.multiple === 0) || list[0];",
