  "item": [
    {
      "name": "1. Catálogo",
      "item": [
        {
          "name": "Listar productos (página 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products?page=1&limit=5",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Estructura { items, page, limit }', () => {",
                  "  pm.expect(j.items).to.be.an('array');",
                  "  pm.expect(j.page).to.eql(1);",
                  "  pm.expect(j.limit).to.eql(5);",
                  "  pm.expect(j.items.length).to.be.at.most(5);",
                  "});",
                  "pm.test('Cada producto cumple el esquema Product del contrato', () => {",
                  "  j.items.forEach(p => {",
                  "    pm.expect(p).to.include.keys('id','name','category','available','supplier','supplierId','unit','minimum','multiple','stock','price','currency');",
                  "    pm.expect(p.price).to.match(/^\\d+\\.\\d{2}$/);",
                  "    pm.expect(p.currency).to.eql('PEN');",
                  "  });",
                  "});",
                  "pm.test('Tiempo de respuesta < 500 ms (EQ-01)', () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar y ordenar por precio",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products?q=papel&sort=price-asc&limit=20",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().items;",
                  "pm.test('Orden ascendente por precio', () => {",
                  "  for (let i = 1; i < items.length; i++) pm.expect(Number(items[i].price)).to.be.at.least(Number(items[i-1].price));",
                  "});"
                ]
              }
            }
          ]
        },
