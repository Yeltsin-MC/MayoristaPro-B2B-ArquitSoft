              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Lista no vacía', () => pm.expect(list).to.be.an('array').that.is.not.empty);",
                  "const wanted = pm.variables.get('proveedorNombre');",
                  "const p = list.find(x => x.name === wanted);",
                  "pm.test('El proveedor del entorno (proveedorNombre) está en la lista', () => pm.expect(p, 'No existe: ' + wanted).to.be.an('object'));",
                  "pm.collectionVariables.set('proveedorId', (p || list[0]).id);"
                ]
              }
            }
          ]
